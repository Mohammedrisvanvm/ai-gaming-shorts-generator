@app.get("/projects/{project_id}/highlights")
def project_highlights(project_id: str):
    with connect_db() as db:
        if db.execute("SELECT 1 FROM projects WHERE id=?", (project_id,)).fetchone() is None:
            raise HTTPException(404, "Project not found.")
        rows = db.execute("SELECT * FROM highlights WHERE project_id=? ORDER BY start_seconds", (project_id,)).fetchall()
    return {"highlights": [dict(row) for row in rows]}


@app.post("/projects/{project_id}/highlights/{highlight_id}/render")
def render_highlight(project_id: str, highlight_id: str):
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        raise HTTPException(503, "FFmpeg was not found. Restart VS Code after installing it.")
    with connect_db() as db:
        project = db.execute("SELECT * FROM projects WHERE id=?", (project_id,)).fetchone()
        highlight = db.execute("SELECT * FROM highlights WHERE id=? AND project_id=?", (highlight_id, project_id)).fetchone()
    if project is None or highlight is None:
        raise HTTPException(404, "Project or highlight not found.")
    if project["source_type"] != "local_file":
        raise HTTPException(400, "Upload an authorized local video before rendering clips.")
    source = Path(project["source_path"] or "").resolve()
    try:
        source.relative_to(SOURCES_DIR)
    except ValueError:
        raise HTTPException(400, "Invalid source video path.")
    if not source.is_file():
        raise HTTPException(404, "Source video file is missing.")
    start = max(0.0, float(highlight["start_seconds"]))
    duration = max(1.0, min(90.0, float(highlight["end_seconds"]) - start))
    clip_id = str(uuid.uuid4())
    output = (CLIPS_DIR / f"{clip_id}.mp4").resolve()
    # Center-crop to vertical 9:16. Smart player/ball tracking is a later improvement.
    vf = "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,fps=30,setsar=1"
    command = [ffmpeg, "-hide_banner", "-loglevel", "error", "-y", "-ss", f"{start:.3f}", "-i", str(source),
               "-t", f"{duration:.3f}", "-vf", vf, "-c:v", "libx264", "-preset", "medium", "-crf", "22",
               "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "128k", "-movflags", "+faststart", str(output)]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=900, check=False)
    except subprocess.TimeoutExpired:
        output.unlink(missing_ok=True)
        raise HTTPException(422, "Clip rendering timed out after 15 minutes.")
    if result.returncode != 0 or not output.is_file():
        output.unlink(missing_ok=True)
        raise HTTPException(422, "FFmpeg could not render the clip: " + (result.stderr[-600:] if result.stderr else "unknown error"))
    record = {"id": clip_id, "project_id": project_id, "highlight_id": highlight_id, "file_path": str(output),
              "created_at": datetime.now(timezone.utc).isoformat(), "start_seconds": start, "end_seconds": start+duration}
    with connect_db() as db:
        db.execute("INSERT INTO clips (id,project_id,highlight_id,file_path,created_at,start_seconds,end_seconds) VALUES (:id,:project_id,:highlight_id,:file_path,:created_at,:start_seconds,:end_seconds)", record)
        db.commit()
    return {"clip": {"id": clip_id, "project_id": project_id, "highlight_id": highlight_id,
            "created_at": record["created_at"], "start_seconds": start, "end_seconds": start+duration,
            "width": 1080, "height": 1920, "file_url": f"/api/clips/{clip_id}/file"}}


@app.get("/clips/{clip_id}/file")
def get_clip_file(clip_id: str):
    with connect_db() as db:
        row = db.execute("SELECT * FROM clips WHERE id=?", (clip_id,)).fetchone()
    if row is None:
        raise HTTPException(404, "Clip not found.")
    file_path = Path(row["file_path"]).resolve()
    try:
        file_path.relative_to(CLIPS_DIR)
    except ValueError:
        raise HTTPException(400, "Invalid clip path.")
    if not file_path.is_file():
        raise HTTPException(404, "Rendered clip file is missing.")
    return FileResponse(file_path, media_type="video/mp4", filename=f"gaming-short-{clip_id[:8]}.mp4")


if __name__ == "__main__":
    uvicorn.run("main:app", host=os.getenv("WORKER_HOST", "127.0.0.1"), port=int(os.getenv("WORKER_PORT", "8001")), reload=False)
